rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Community post images. Only the signed-in owner may write under their
    // own uid namespace; any signed-in user may read (feed images). Size and
    // content-type are constrained to real photos.
    match /community/{userId}/{postId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // AI Chat attachments. Files are private to the signed-in owner.
    // Keep uploads small enough for a responsive mobile chat experience.
    match /chat/{userId}/{fileName} {
      allow read, delete: if request.auth != null
        && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Everything else is denied by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
