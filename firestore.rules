rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return request.auth.uid;
    }

    // Private user profile, farms, crops and community activity.
    match /users/{userId} {
      allow read, write: if signedIn() && me() == userId;

      // Activity inbox drives the Community badge. Any signed-in member may
      // create a notification in another member's inbox ONLY when they are the
      // recorded actor (interest/comment/status change). Only the owner of the
      // inbox may read, mark read, or delete.
      match /community_activity/{activityId} {
        allow read, update, delete: if signedIn() && me() == userId;
        allow create: if signedIn()
          && request.resource.data.ownerId == userId
          && request.resource.data.actorId == me();
      }

      match /{document=**} {
        allow read, write: if signedIn() && me() == userId;
      }
    }

    // Community posts: one collection shared by experience / harvest / demand.
    // Posts are visible to every signed-in farmer; a post is always created
    // under the author's own uid. Counter fields (likeCount, commentCount,
    // interestedCount, supplierCount) are updated by other members reacting to
    // the post, so updates are allowed for signed-in users.
    match /community_posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == me();
      // The post owner may edit their own post. Other members may only
      // update aggregate interaction counters used by the existing client;
      // they cannot change author, crop, price, location, content, or type.
      allow update: if signedIn()
        && (
          resource.data.authorId == me()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likeCount',
            'commentCount',
            'interestedCount',
            'supplierCount',
            'updatedAt'
          ])
        );
      allow delete: if signedIn() && resource.data.authorId == me();

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == me();
        allow update, delete: if signedIn()
          && resource.data.authorId == me();
      }

      match /likes/{likeId} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && likeId == me();
      }

      // Interest (harvest) and supplier (demand) records. The sender may
      // withdraw; the post owner may accept/decline.
      match /interests/{memberId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && memberId == me()
          && request.resource.data.userId == me();
        allow update, delete: if signedIn()
          && (resource.data.userId == me()
            || resource.data.postAuthorId == me());
      }

      match /suppliers/{memberId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && memberId == me()
          && request.resource.data.userId == me();
        allow update, delete: if signedIn()
          && (resource.data.userId == me()
            || resource.data.postAuthorId == me());
      }
    }
  }
}
