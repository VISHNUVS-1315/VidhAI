# Firebase Cloud Functions secrets -> set once with:
#   firebase functions:secrets:set GROQ_API_KEY
#   firebase functions:secrets:set GEMINI_API_KEY
#
# Values NEVER appear in this repo. The runtime injects them server-side.
#
# GROQ_API_KEY=          # https://console.groq.com
# GEMINI_API_KEY=        # https://aistudio.google.com/app/apikey
#
# Optional:
# GOOGLE_CLOUD_TTS_SA_JSON=   # Service-account JSON string IF the project's
#                             # default runtime service account lacks TTS (see README)
# GROQ_MODEL=openai/gpt-oss-20b   # cheaper/alternate reasoning model
# TTS_GENDER_FEMALE=true          # prefer female voices when available