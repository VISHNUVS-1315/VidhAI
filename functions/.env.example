# VidhAI backend — environment variables (names only; NEVER commit values).
#
# The backend runs either as a standalone Node server (Render free plan /
# `npm start`) or inside the Firebase Functions emulator. All secrets are read
# from process.env. Local dev: put values in `.secret.local` (gitignored).
# Render: enter values in the dashboard (see ../render.yaml).
#
# ============================================================================
# REQUIRED
# ============================================================================
# FIREBASE_SERVICE_ACCOUNT_JSON=   # Service-account JSON string for project
#                                  # vidhai-app. REQUIRED for the standalone
#                                  # server (Render): verifies Firebase Auth ID
#                                  # tokens and enables Firestore. Not needed in
#                                  # the emulator or on Cloud Functions (default
#                                  # credentials are ambient there).
# NVIDIA_API_KEY=                  # https://build.nvidia.com — primary key for
#                                  # every AI tier (chat router, vision, safety).
#
# ============================================================================
# REQUIRED for full feature set (each has a documented fallback)
# ============================================================================
# DEEPGRAM_API_KEY=                # STT (Nova-3), TTS (Aura) and realtime
#                                  # sessions. Without it, STT falls back to
#                                  # Groq Whisper and TTS falls back to Google.
# DATA_GOV_API_KEY=                # https://api.data.gov.in — AGMARKNET market
#                                  # prices. Without it, AGMARKNET is disabled.
#
# ============================================================================
# OPTIONAL (enable extra engines / legacy providers)
# ============================================================================
# GROQ_API_KEY=                    # Whisper STT, market insight rewrite, and the
#                                  # legacy provider:'groq' chat path.
# GEMINI_API_KEY=                  # Vision fallback + legacy provider:'gemini'.
# GOOGLE_CLOUD_TTS_SA_JSON=        # Service-account JSON string IF the default
#                                  # runtime credentials lack Cloud TTS scope.
# CROP_SEED_TOKEN=                 # Enables POST /crop/seed (ops only).
# MANDI_API_KEY=                   # Legacy alias for the market key; DATA_GOV
#                                  # takes precedence.
#
# ============================================================================
# AI TIER ROUTING (env-configurable; no app/UI change required)
# ============================================================================
# ENABLE_DEEPSEEK=false            # DeepSeek V4 Flash is DISABLED by default
#                                  # (repeated timeouts); `general` is served by
#                                  # Nemotron Lightning -> Ultra fallback. Set
#                                  # true to re-enable DeepSeek (kept in config).
# AI_MODEL_MAIN=nvidia/nemotron-3-ultra-550b-a55b
# AI_MODEL_GENERAL=deepseek-ai/deepseek-v4-flash-0731   # active only if
#                                  # ENABLE_DEEPSEEK=true
# AI_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b   # fast AND general tier
# AI_MODEL_VISION=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# AI_MODEL_SAFETY=nvidia/nemotron-3.5-content-safety
# AI_MODEL_CREATIVE=meta/muse-glimmer-30b
# AI_MODEL_STT=whisper-large-v3-turbo
#
# ============================================================================
# PER-TIER NVIDIA KEYS (FALLBACK: each defaults to NVIDIA_API_KEY)
# ============================================================================
# AI_KEY_MAIN=
# AI_KEY_GENERAL=                  # key for the (disabled) DeepSeek tier
# AI_KEY_FAST=
# AI_KEY_VISION=
# AI_KEY_SAFETY=
# AI_KEY_CREATIVE=
#
# ============================================================================
# SERVER / PROVIDER OVERRIDES (optional)
# ============================================================================
# PORT=8080                        # Render injects PORT automatically.
# APP_VERSION=1.0.0                # reported by GET /health.
# CORS_ORIGINS=*                   # '*' (default) or comma-separated web origins.
# GROQ_MODEL=openai/gpt-oss-20b    # crop AI / legacy chat model.
# NVIDIA_MODEL=openai/gpt-oss-20b  # NVIDIA fallback provider (defaults to GROQ_MODEL).
# NVIDIA_BASE_URL=                 # override the NVIDIA NIM-compatible base URL.
# GROQ_BASE_URL=                   # override the Groq-compatible base URL.
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL=                 # override the Gemini API base URL.
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_BASE_URL=
# MANDI_API_BASE_URL=              # override the market aggregator base URL.
# WHISPER_MODEL=whisper-large-v3-turbo
# GROQ_REASONING=medium            # reasoning_effort for gpt-oss-* models.
# TTS_GENDER_FEMALE=true           # prefer female voices when available.