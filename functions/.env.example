# VidhAI backend — environment variables (names only; NEVER commit values).
#
# Production architecture:
#   AI            -> NVIDIA NIM only
#   Market prices -> data.gov.in / AGMARKNET
#   Auth/Firestore-> Firebase
#   Weather       -> Open-Meteo (no key)
#   Voice input   -> on-device speech recognition
#   Voice output  -> on-device TTS
#
# Render: add secret values in Dashboard -> VidhAI -> Environment.
# Local development: store values in a gitignored local env file.

# ============================================================================
# REQUIRED SECRETS
# ============================================================================
# NVIDIA_API_KEY=                  # One NVIDIA key for all AI tiers:
#                                  # chat, orchestration, crop AI, vision,
#                                  # safety and other NVIDIA model calls.
#
# DATA_GOV_API_KEY=                # Official data.gov.in / AGMARKNET prices.
#
# FIREBASE_SERVICE_ACCOUNT_JSON=   # Whole Firebase service-account JSON string
#                                  # for project vidhai-app. Used by Render to
#                                  # verify Firebase ID tokens and access
#                                  # Firestore through Firebase Admin.

# ============================================================================
# NON-SECRET CONFIGURATION
# ============================================================================
# FIREBASE_PROJECT_ID=vidhai-app
# APP_VERSION=1.0.0
# CORS_ORIGINS=*
# PORT=8080                        # Render injects PORT automatically.

# ============================================================================
# NVIDIA MODEL ROUTING — OPTIONAL OVERRIDES
# Leave unset to use the defaults in src/aiGateway.ts.
# ============================================================================
# AI_MODEL_MAIN=nvidia/nemotron-3-ultra-550b-a55b
# AI_MODEL_GENERAL=nvidia/nemotron-3.5-lightning-30b-a3b
# AI_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
# AI_MODEL_VISION=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# AI_MODEL_SAFETY=nvidia/nemotron-3.5-content-safety
# AI_MODEL_CREATIVE=nvidia/nemotron-3-ultra-550b-a55b

# Optional NVIDIA endpoint override for compatible NVIDIA NIM deployments.
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
